# ── Database (Supabase, Mumbai) ──
DATABASE_URL=postgresql://postgres.your-project-ref:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
SUPABASE_URL=https://your-project-ref.supabase.co
# Server-only secret key. Never put this in the web app.
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET=rentflow-private

# ── App ──
APP_URL=https://app.rentflow.app
# Long random string; signs receipt verification links. Never change it after launch.
RECEIPT_SIGNING_SECRET=

# ── WhatsApp Cloud API (Meta) ──
WA_ACCESS_TOKEN=
WA_PHONE_NUMBER_ID=
WA_APP_SECRET=
WA_VERIFY_TOKEN=
WA_GRAPH_VERSION=v21.0
# Approx. cost of one utility template message in paise (for the message log).
WA_TEMPLATE_COST_PAISE=12

# ── Inbound email (forwarded bank alerts) ──
INBOUND_EMAIL_DOMAIN=in.rentflow.app
INBOUND_EMAIL_SECRET=

# ── Receipts (headless Chromium for PDFs) ──
# CHROME_PATH=/usr/bin/chromium
